# ESYR 환경변수 예시 — 실제 비밀값은 여기에 넣지 않는다
ESYR_SECRET_KEY=change-me-to-a-random-64-char-hex

# 로컬(기본): SQLite. 비우면 instance/esyr.sqlite3 사용
# DATABASE_URL=sqlite:///instance/esyr.sqlite3

# Supabase(Postgres) 사용 시
# DATABASE_URL=postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Supabase Storage 사용 시 (PDF 원본 보관)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...
# SUPABASE_BUCKET=esyr-docs
